# 复制本文件为 .env 并填入你的 DeepSeek API Key，然后执行 ./start.sh 启动全部服务
# 未填写 DEEPSEEK_API_KEY 时，系统自动启用本地上下文感知温和兜底模式，所有流程仍可完整演示

# DeepSeek 大模型配置 (OpenAI 兼容接口)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# MySQL 数据库配置
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=emotion_agent
DB_USERNAME=root
DB_PASSWORD=

# 后端端口与 JWT 密钥
SERVER_PORT=8088
JWT_SECRET=EmotionAgentGradProjectSecretKey2026ForJWTSigningMinimum32Bytes!

# Python NLP 扩展对照服务地址
NLP_SERVICE_URL=http://127.0.0.1:8001
NLP_EXTERNAL_ENABLED=true
